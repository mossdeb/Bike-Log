NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — never expose with NEXT_PUBLIC_. Used only for admin
# operations (deleting a user account, and the notification cron job
# reading across all users). Supabase dashboard → Project Settings → API →
# service_role key.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. resend.com dashboard → API Keys. Used to send maintenance
# reminder emails.
RESEND_API_KEY=
# Server-only. Any random string — shared secret checked against the
# Authorization header on /api/cron/check-services so only Vercel Cron (or
# you, manually) can trigger it.
CRON_SECRET=
# Server-only. Stripe dashboard → Developers → API keys. Use the test-mode
# secret key while developing.
STRIPE_SECRET_KEY=
# Server-only. Stripe dashboard → Developers → Webhooks → your endpoint →
# Signing secret. Locally, `stripe listen` prints one for you.
STRIPE_WEBHOOK_SECRET=
# Price IDs for the two paid plans (Stripe dashboard → Product catalog).
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_PRO=
