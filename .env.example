NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — never expose with NEXT_PUBLIC_. Used only for admin
# operations (deleting a user account, and the notification cron job
# reading across all users). Supabase dashboard → Project Settings → API →
# service_role key.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. resend.com dashboard → API Keys. Used to send maintenance
# reminder emails.
RESEND_API_KEY=
# Server-only. Any random string — shared secret checked against the
# Authorization header on /api/cron/check-services so only Vercel Cron (or
# you, manually) can trigger it.
CRON_SECRET=
# Server-only. Stripe dashboard → Developers → API keys. Use the test-mode
# secret key while developing.
STRIPE_SECRET_KEY=
# Server-only. Stripe dashboard → Developers → Webhooks → your endpoint →
# Signing secret. Locally, `stripe listen` prints one for you.
STRIPE_WEBHOOK_SECRET=
# Price IDs for the two paid plans (Stripe dashboard → Product catalog).
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_PRO=
# Server-only. strava.com/settings/api → your API application. Used to
# import ride distance/time from Strava into a bike's totals.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Server-only. Any random string you make up — Strava echoes it back when
# verifying the webhook subscription callback, so we can confirm it's
# really Strava (and not someone else) hitting our endpoint.
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Web Push (VAPID). Generate a pair with `npx web-push generate-vapid-keys`.
# The public key is shipped to the browser to create push subscriptions; the
# private key signs the requests to the push service and must stay server-only.
# Regenerating them invalidates every existing subscription — every device has
# to opt in again.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push service can reach you at if a subscription
# misbehaves. Must be a mailto: or https: URL.
VAPID_SUBJECT=
